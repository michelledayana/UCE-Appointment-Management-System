# ==========================
# APP
# ==========================
APP_NAME=appointment-management-service
APP_PORT=8088
ENVIRONMENT=local

# ==========================
# DATABASE
# ==========================
DATABASE_URL=postgresql+psycopg2://appointment_user:appointment_pass@db-appointments:5432/appointments_db
DB_HOST=db-appointments
DB_PORT=5432
DB_NAME=appointments_db
DB_USER=postgres
DB_PASSWORD=postgres

# ==========================
# KAFKA
# ==========================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_APPOINTMENT_CREATED=appointment_created

# ==========================
# LOGGING
# ==========================
LOG_LEVEL=INFO
