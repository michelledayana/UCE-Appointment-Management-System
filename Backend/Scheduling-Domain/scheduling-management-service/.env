# ===============================
# APP CONFIG
# ===============================
APP_NAME=Scheduling Management Service
ENVIRONMENT=qa
DEBUG=true

# ===============================
# SERVER
# ===============================
HOST=0.0.0.0
PORT=8085

# ===============================
# DATABASE
# ===============================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/scheduling_db

# ===============================
# SECURITY
# ===============================
JWT_SECRET_KEY=super-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===============================
# CORS
# ===============================
CORS_ORIGINS=*

# ===============================
# WEBSOCKET COMMUNICATION
# ===============================
WEBSOCKET_NAMESPACE=/availability