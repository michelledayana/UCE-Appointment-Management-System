# ===============================
# APP CONFIG
# ===============================
APP_NAME=Scheduling Management Service
ENVIRONMENT=qa
DEBUG=true

# ===============================
# SERVER
# ===============================
HOST=0.0.0.0
PORT=8085

# ===============================
# PostgreSQL
# ===============================
POSTGRES_DB=scheduling_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=10.0.1.201
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://postgres:postgres@10.0.1.201:5432/scheduling_db

# ===============================
# SECURITY
# ===============================
JWT_SECRET_KEY=super-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===============================
# CORS
# ===============================
CORS_ORIGINS=*

# ===============================
# WEBSOCKET COMMUNICATION
# ===============================
WEBSOCKET_NAMESPACE=/availability