# ===============================
# APPLICATION
# ===============================
APP_NAME=availability-validation-service
ENV=development

# ===============================
# REDIS (CACHE)
# ===============================
REDIS_HOST=redis_catalog
REDIS_PORT=6379

# ===============================
# MONGODB
# ===============================
MONGO_URI=mongodb://mongodb_catalog:27017/availability_db

# ===============================
# KAFKA
# ===============================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_AVAILABILITY_TOPIC=availability.events
KAFKA_VALIDATION_TOPIC=availability.validation

# ===============================
# LOGGING
# ===============================
LOG_LEVEL=INFO
